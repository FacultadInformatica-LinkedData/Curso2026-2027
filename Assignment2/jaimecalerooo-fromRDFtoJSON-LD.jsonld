{
  "@context": {
    "ex": "http://example.org/jsonld-exercise/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "includes": { "@id": "ex:includes", "@type": "@id" },
    "hasOwner": { "@id": "ex:hasOwner", "@type": "@id" },
    "hasName": "ex:hasName",
    "hasMeasurement": { "@id": "ex:hasMeasurement", "@type": "@id" },
    "hasTemperature": { "@id": "ex:hasTemperature", "@type": "xsd:integer" },
    "atTime": { "@id": "ex:atTime", "@type": "xsd:dateTime" }
  },
  "@graph": [
    {
      "@id": "ex:Sensor029",
      "includes": "ex:Class01",
      "hasMeasurement": "ex:Measurement8401"
    },
    {
      "@id": "ex:Class01",
      "includes": "ex:Computer101"
    },
    {
      "@id": "ex:Computer101",
      "hasOwner": "ex:User10A"
    },
    {
      "@id": "ex:User10A",
      "hasName": "Pedro"
    },
    {
      "@id": "ex:Measurement8401",
      "hasTemperature": 29,
      "atTime": "2010-06-12T12:00:12"
    }
  ]
}
