    ns1:publicTransport "Bus: 32, 71" .

<https://parques-jardines.madrid.data.es/resource/park/5983786> a ns1:Park ;
    rdfs:label "Parque Vandel" ;
    ns1:accessibility 2 ;
    ns1:contentUrl "http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&vgnextoid=236dc11457f8e210VgnVCM2000000c205a0aRCRD"^^xsd:anyURI ;
    ns1:description "El Parque Vandel es un espacio verde alargado que se extiende sobre la explanaci�n del antiguo tren de Arganda, transformando esta �rea hist�rica en un entorno para el esparcimiento y el descanso. El ferrocarril conectaba Madrid con el valle del Taju�a y sus vestigios a�n existen en el Parque Martal�-Dionisio Ridruejo. El parque Vandel est� estructurado con amplios paseos centrales y una red de viales terrizos de trazado geom�trico, que facilitan la circulaci�n y definen parcelas ajardinadas con una variada selecci�n de arbustos arom�ticos. A lo largo de sus senderos, sus visitantes pueden disfrutar de distintas presentaciones de vegetaci�n. Los paseos conectan las plazoletas y est�n recorridos por una hilera de cipreses en la parte central, que deja sus dos lados transitables. En las peque�as parcelas que se forman por los caminos crece una pradera natural con diferentes arbustos y arbolado, como pinos, arces, casta�os de Indias, cedros, chopos y pl�tanos de sombra, entre otros. Entre sus instalaciones destacan las zonas de juegos infantiles. El Parque Vandel es un lugar muy recurrido por quienes buscan dar un paseo tranquilo, desconectar del bullicio urbano y disfrutar de un ambiente relajante." ;
    ns1:facilities "Zonas infantiles" ;
    ns1:hasAddress <https://parques-jardines.madrid.data.es/resource/address/5983786> ;
    ns1:latitude 40.4049148503112 ;
