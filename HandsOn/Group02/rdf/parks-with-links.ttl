    ns1:locatedInNeighborhood <https://parques-jardines.madrid.data.es/resource/neighborhood/8-5> ;
    ns1:longitude -3.6933504628706095 ;
    ns1:parkName "Parque Norte - Carmen Tagle" ;
    ns1:publicTransport "Bus: 124, 137" .

