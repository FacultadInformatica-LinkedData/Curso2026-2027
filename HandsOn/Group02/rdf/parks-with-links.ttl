    ns1:longitude -3.6238430832643598 ;
    ns1:parkName "Parque Vallecas Villa" ;
    ns1:publicTransport "Bus: 54, 103, 142 y N9 Metro: Congosto (l�nea 1)" .

<https://parques-jardines.madrid.data.es/resource/park/5998367> a ns1:Park ;
