@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix parks: <https://parques-jardines.madrid.data.es/ontology#> .


<#ParkMapping> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "../csv/200761-0-parques-jardines-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "https://parques-jardines.madrid.data.es/resource/park/{PK}" ;
        rr:class parks:Park
    ] ;
    rr:predicateObjectMap [
        rr:predicate parks:parkName ;
        rr:objectMap [ rml:reference "NOMBRE" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "NOMBRE" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate parks:description ;
        rr:objectMap [ rml:reference "DESCRIPCION-ENTIDAD" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate parks:openingHours ;
        rr:objectMap [ rml:reference "HORARIO" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate parks:facilities ;
        rr:objectMap [ rml:reference "EQUIPAMIENTO" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate parks:publicTransport ;
        rr:objectMap [ rml:reference "TRANSPORTE" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate parks:accessibility ;
        rr:objectMap [ rml:reference "ACCESIBILIDAD" ; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate parks:contentUrl ;
        rr:objectMap [ rml:reference "CONTENT-URL" ; rr:datatype xsd:anyURI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate parks:latitude ;
        rr:objectMap [ rml:reference "LATITUD" ; rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate parks:longitude ;
        rr:objectMap [ rml:reference "LONGITUD" ; rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate parks:hasAddress ;
        rr:objectMap [ rr:template "https://parques-jardines.madrid.data.es/resource/address/{PK}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate parks:locatedInDistrict ;
        rr:objectMap [ rr:template "https://parques-jardines.madrid.data.es/resource/district/{COD-DISTRITO}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate parks:locatedInNeighborhood ;
        rr:objectMap [ rr:template "https://parques-jardines.madrid.data.es/resource/neighborhood/{COD-DISTRITO}-{COD-BARRIO}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate owl:sameAs ;
        rr:objectMap [ rml:reference "NOMBRE-WD" ; rr:termType rr:IRI ]
    ] .

<#AddressMapping> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "../csv/200761-0-parques-jardines-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "https://parques-jardines.madrid.data.es/resource/address/{PK}" ;
        rr:class parks:Address
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "NOMBRE-VIA" ; rr:datatype xsd:string ]
    ] .

<#DistrictMapping> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "../csv/200761-0-parques-jardines-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "https://parques-jardines.madrid.data.es/resource/district/{COD-DISTRITO}" ;
        rr:class parks:District
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "DISTRITO" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate owl:sameAs ;
        rr:objectMap [ rml:reference "DISTRITO-WD" ; rr:termType rr:IRI ]
    ] .

<#NeighborhoodMapping> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "../csv/200761-0-parques-jardines-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "https://parques-jardines.madrid.data.es/resource/neighborhood/{COD-DISTRITO}-{COD-BARRIO}" ;
        rr:class parks:Neighborhood
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "BARRIO" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate owl:sameAs ;
        rr:objectMap [ rml:reference "BARRIO-WD" ; rr:termType rr:IRI ]
    ] .
