    },
    "columnName": "EQUIPAMIENTO",
    "expression": "value.unescape(\"html\").unescape(\"html\").replace(/\\s+/, \" \").trim()",
    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 10,
    "description": "Decode HTML entities and collapse whitespace in EQUIPAMIENTO"
  },
  {
    "op": "core/text-transform",
    "engineConfig": {
      "facets": [],
      "mode": "row-based"
    },
    "columnName": "TRANSPORTE",
    "expression": "value.unescape(\"html\").unescape(\"html\").replace(/\\s+/, \" \").trim()",
    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 10,
    "description": "Decode HTML entities and collapse whitespace in TRANSPORTE"
  },
  {
    "op": "core/text-transform",
    "engineConfig": {
