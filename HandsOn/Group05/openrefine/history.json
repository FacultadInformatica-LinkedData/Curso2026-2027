    "engineConfig": {
      "facets": [],
      "mode": "row-based"
    },
    "columnName": "HORARIO",
    "expression": "value.unescape(\"html\").unescape(\"html\").replace(/\\s+/, \" \").trim()",
    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 10,
    "description": "Decode HTML entities and collapse whitespace in HORARIO"
  },
  {
    "op": "core/text-transform",
    "engineConfig": {
