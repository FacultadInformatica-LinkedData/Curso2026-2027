@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix rml: <http://semweb.mmlab.be/ns/rml#>.
@prefix ql: <http://semweb.mmlab.be/ns/ql#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://educamadrid.linkeddata.es/ontology/CentroEducativo#> .
@prefix res: <http://educamadrid.linkeddata.es/resource/> .

#################################################################
# 1. TriplesMap para Centros Educativos (EducationalCenter)
#################################################################
<#TriplesMapSchool> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "../csv/300614-1-centros-educativos-csv-updated.csv" ;
    rml:referenceFormulation ql:CSV 
  ];
  rr:subjectMap [
    rr:template "http://educamadrid.linkeddata.es/resource/School/{PK}";
    rr:class :EducationalCenter
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [
      rml:reference "NOMBRE";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :pk;
    rr:objectMap [
      rml:reference "PK";
      rr:datatype xsd:integer
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :centerName;
    rr:objectMap [
      rml:reference "NOMBRE";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :centerType;
    rr:objectMap [
      rml:reference "TIPO";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :description;
    rr:objectMap [
      rml:reference "DESCRIPCION";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :schedule;
    rr:objectMap [
      rml:reference "HORARIO";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :equipment;
    rr:objectMap [
      rml:reference "EQUIPAMIENTO";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :transportation;
    rr:objectMap [
      rml:reference "TRANSPORTE";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :telephone;
    rr:objectMap [
      rml:reference "TELEFONO";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :email;
    rr:objectMap [
      rml:reference "EMAIL";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :contentUrl;
    rr:objectMap [
      rml:reference "CONTENT-URL";
      rr:datatype xsd:anyURI
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :hasAddress;
    rr:objectMap [
      rr:template "http://educamadrid.linkeddata.es/resource/Address/{PK}";
      rr:termType rr:IRI
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :hasAccessibility;
    rr:objectMap [
      rr:template "http://educamadrid.linkeddata.es/resource/Accessibility/{ACCESIBILIDAD}";
      rr:termType rr:IRI
    ]
  ] .


#################################################################
# 2. TriplesMap para Direcciones (Address)
#################################################################
<#TriplesMapAddress> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "../csv/300614-1-centros-educativos-csv-updated.csv" ;
    rml:referenceFormulation ql:CSV 
  ];
  rr:subjectMap [
    rr:template "http://educamadrid.linkeddata.es/resource/Address/{PK}";
    rr:class :Address
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [
      rml:reference "NOMBRE-VIA";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :streetType;
    rr:objectMap [
      rml:reference "CLASE-VIAL";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :streetName;
    rr:objectMap [
      rml:reference "NOMBRE-VIA";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :streetNumber;
    rr:objectMap [
      rml:reference "NUM";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :postalCode;
    rr:objectMap [
      rml:reference "CODIGO-POSTAL";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :latitude;
    rr:objectMap [
      rml:reference "LATITUD";
      rr:datatype xsd:double
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :longitude;
    rr:objectMap [
      rml:reference "LONGITUD";
      rr:datatype xsd:double
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :inDistrict;
    rr:objectMap [
      rr:template "http://educamadrid.linkeddata.es/resource/District/{DISTRITO}";
      rr:termType rr:IRI
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :inNeighborhood;
    rr:objectMap [
      rr:template "http://educamadrid.linkeddata.es/resource/Neighborhood/{BARRIO}";
      rr:termType rr:IRI
    ]
  ] .


#################################################################
# 3. TriplesMap para Distritos (District)
#################################################################
<#TriplesMapDistrict> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "../csv/300614-1-centros-educativos-csv-updated.csv" ;
    rml:referenceFormulation ql:CSV 
  ];
  rr:subjectMap [
    rr:template "http://educamadrid.linkeddata.es/resource/District/{DISTRITO}";
    rr:class :District
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [
      rml:reference "DISTRITO";
      rr:datatype xsd:string
    ]
  ] .


#################################################################
# 4. TriplesMap para Accesibilidad (Accessibility)
#################################################################
<#TriplesMapAccessibility> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "../csv/300614-1-centros-educativos-csv-updated.csv" ;
    rml:referenceFormulation ql:CSV 
  ];
  rr:subjectMap [
    rr:template "http://educamadrid.linkeddata.es/resource/Accessibility/{ACCESIBILIDAD}";
    rr:class :Accessibility
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [
      rml:reference "ACCESIBILIDAD";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :accessibilityCode;
    rr:objectMap [
      rml:reference "ACCESIBILIDAD";
      rr:datatype xsd:string
    ]
  ] .


#################################################################
# 5. TriplesMap para Barrios (Neighborhood)
#################################################################
<#TriplesMapNeighborhood> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "../csv/300614-1-centros-educativos-csv-updated.csv" ;
    rml:referenceFormulation ql:CSV 
  ];
  rr:subjectMap [
    rr:template "http://educamadrid.linkeddata.es/resource/Neighborhood/{BARRIO}";
    rr:class :Neighborhood
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [
      rml:reference "BARRIO";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate :belongsToDistrict;
    rr:objectMap [
      rr:template "http://educamadrid.linkeddata.es/resource/District/{DISTRITO}";
      rr:termType rr:IRI
    ]
  ] .