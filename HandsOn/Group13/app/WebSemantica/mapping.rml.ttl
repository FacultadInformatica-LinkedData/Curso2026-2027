@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix ex: <http://educamadrid.linkeddata.es/resource/> .
@prefix ont: <http://educamadrid.linkeddata.es/ontology/CentroEducativo#> .

#################################################################
# 1. TriplesMap para Centros Educativos (EducationalCenter)
#################################################################
<#TriplesMapSchool> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/300614-1-centros-educativos-csv-updated.csv" ;
        rml:referenceFormulation ql:CSV 
    ] ;
    rr:subjectMap [
        rr:template "http://educamadrid.linkeddata.es/resource/EducationalOrganization/CentroEducativo/Madrid/{NOMBRE}" ;
        rr:class ont:EducationalCenter
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "NOMBRE" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:centerName ;
        rr:objectMap [ rml:reference "NOMBRE" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:centerType ;
        rr:objectMap [ rml:reference "TIPO" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:description ;
        rr:objectMap [ rml:reference "DESCRIPCION" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:schedule ;
        rr:objectMap [ rml:reference "HORARIO" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:equipment ;
        rr:objectMap [ rml:reference "EQUIPAMIENTO" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:transportation ;
        rr:objectMap [ rml:reference "TRANSPORTE" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:telephone ;
        rr:objectMap [ rml:reference "TELEFONO" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:email ;
        rr:objectMap [ rml:reference "EMAIL" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:contentUrl ;
        rr:objectMap [ rml:reference "CONTENT-URL" ; rr:datatype xsd:anyURI ]
    ] ;

    # Accesibilidad corregida como literal (DatatypeProperty)
    rr:predicateObjectMap [
        rr:predicate ont:accessibilityCode ;
        rr:objectMap [ rml:reference "ACCESIBILIDAD" ; rr:datatype xsd:string ]
    ] ;

    # Enlace a la dirección con URI human-readable y significativa
    rr:predicateObjectMap [
        rr:predicate ont:hasAddress ;
        rr:objectMap [ 
            rr:template "http://educamadrid.linkeddata.es/resource/Address/Madrid/{CLASE-VIAL}/{NOMBRE-VIA}/{NUM}" ;
            rr:termType rr:IRI 
        ]
    ] .


#################################################################
# 2. TriplesMap para Direcciones (Address)
#################################################################
<#TriplesMapAddress> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/300614-1-centros-educativos-csv-updated.csv" ;
        rml:referenceFormulation ql:CSV 
    ] ;
    rr:subjectMap [
        rr:template "http://educamadrid.linkeddata.es/resource/Address/Madrid/{CLASE-VIAL}/{NOMBRE-VIA}/{NUM}" ;
        rr:class ont:Address
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "NOMBRE-VIA" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:streetType ;
        rr:objectMap [ rml:reference "CLASE-VIAL" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:streetName ;
        rr:objectMap [ rml:reference "NOMBRE-VIA" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:streetNumber ;
        rr:objectMap [ rml:reference "NUM" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:postalCode ;
        rr:objectMap [ rml:reference "CODIGO-POSTAL" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:latitude ;
        rr:objectMap [ rml:reference "LATITUD" ; rr:datatype xsd:double ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:longitude ;
        rr:objectMap [ rml:reference "LONGITUD" ; rr:datatype xsd:double ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:inDistrict ;
        rr:objectMap [ 
            rr:template "http://educamadrid.linkeddata.es/resource/District/{DISTRITO}" ;
            rr:termType rr:IRI 
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:inNeighborhood ;
        rr:objectMap [ 
            rr:template "http://educamadrid.linkeddata.es/resource/Neighborhood/{BARRIO}" ;
            rr:termType rr:IRI 
        ]
    ] .


#################################################################
# 3. TriplesMap para Distritos (District)
#################################################################
<#TriplesMapDistrict> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/300614-1-centros-educativos-csv-updated.csv" ;
        rml:referenceFormulation ql:CSV 
    ] ;
    rr:subjectMap [
        rr:template "http://educamadrid.linkeddata.es/resource/District/{DISTRITO}" ;
        rr:class ont:District
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "DISTRITO" ; rr:datatype xsd:string ]
    ] .


#################################################################
# 4. TriplesMap para Barrios (Neighborhood)
#################################################################
<#TriplesMapNeighborhood> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/300614-1-centros-educativos-csv-updated.csv" ;
        rml:referenceFormulation ql:CSV 
    ] ;
    rr:subjectMap [
        rr:template "http://educamadrid.linkeddata.es/resource/Neighborhood/{BARRIO}" ;
        rr:class ont:Neighborhood
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "BARRIO" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:belongsToDistrict ;
        rr:objectMap [ 
            rr:template "http://educamadrid.linkeddata.es/resource/District/{DISTRITO}" ;
            rr:termType rr:IRI 
        ]
    ] .