@prefix : <http://smartcity.linkeddata.es/touristaccommodation/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://smartcity.linkeddata.es/touristaccommodation/ontology/> a owl:Ontology ;
    rdfs:label "Tourist Accommodation Ontology"@en .


# Classes

:Accommodation a owl:Class ;
    owl:disjointWith :Address, :City ;
    rdfs:comment "A place providing lodging to tourists or travelers."@en ;
    rdfs:label "Accommodation"@en .

:Address a owl:Class ;
    owl:disjointWith :City ;
    rdfs:comment "The physical location details (such as street and postal code) of an accommodation."@en ;
    rdfs:label "Address"@en .

:City a owl:Class ;
    rdfs:comment "A large or important town or municipality where accommodations are located."@en ;
    rdfs:label "City"@en .

# Accommodation type hierarchy (one subclass per value of the source column alojamiento_tipo)

:Hotel a owl:Class ;
    rdfs:subClassOf :Accommodation ;
    rdfs:comment "A hotel establishment."@en ;
    rdfs:label "Hotel"@en .

:Hostel a owl:Class ;
    rdfs:subClassOf :Accommodation ;
    rdfs:comment "A hostel (Spanish 'hostal'), a simple lodging establishment."@en ;
    rdfs:label "Hostel"@en .

:Pension a owl:Class ;
    rdfs:subClassOf :Accommodation ;
    rdfs:comment "A guest house offering rooms with board (Spanish 'pension')."@en ;
    rdfs:label "Pension"@en .

:BoardingHouse a owl:Class ;
    rdfs:subClassOf :Accommodation ;
    rdfs:comment "A boarding house (Spanish 'casa de huespedes')."@en ;
    rdfs:label "Boarding house"@en .

:TouristApartment a owl:Class ;
    rdfs:subClassOf :Accommodation ;
    rdfs:comment "A tourist apartment establishment."@en ;
    rdfs:label "Tourist apartment"@en .

:ApartHotel a owl:Class ;
    rdfs:subClassOf :Accommodation ;
    rdfs:comment "A hotel-apartment establishment combining hotel services with apartments."@en ;
    rdfs:label "Apart-hotel"@en .

:Inn a owl:Class ;
    rdfs:subClassOf :Accommodation ;
    rdfs:comment "An inn (Spanish 'hosteria')."@en ;
    rdfs:label "Inn"@en .

:Camping a owl:Class ;
    rdfs:subClassOf :Accommodation ;
    rdfs:comment "A camping site."@en ;
    rdfs:label "Camping"@en .

:TouristHome a owl:Class ;
    rdfs:subClassOf :Accommodation ;
    rdfs:comment "A private dwelling rented for tourist use (Spanish 'vivienda de uso turistico')."@en ;
    rdfs:label "Tourist home"@en .

:RuralAccommodation a owl:Class ;
    rdfs:subClassOf :Accommodation ;
    rdfs:comment "Any lodging located in a rural setting."@en ;
    rdfs:label "Rural accommodation"@en .

:RuralHouse a owl:Class ;
    rdfs:subClassOf :RuralAccommodation ;
    rdfs:comment "A rural house."@en ;
    rdfs:label "Rural house"@en .

:RuralApartment a owl:Class ;
    rdfs:subClassOf :RuralAccommodation ;
    rdfs:comment "A rural apartment."@en ;
    rdfs:label "Rural apartment"@en .

:RuralHotel a owl:Class ;
    rdfs:subClassOf :RuralAccommodation ;
    rdfs:comment "A rural hotel."@en ;
    rdfs:label "Rural hotel"@en .

# Object Properties

:hasAddress a owl:ObjectProperty ;
    rdfs:domain :Accommodation ;
    rdfs:range :Address ;
    rdfs:comment "Links an accommodation entity to its specific physical address."@en ;
    rdfs:label "has address"@en .

:inCity a owl:ObjectProperty ;
    rdfs:domain :Address ;
    rdfs:range :City ;
    rdfs:comment "Links a physical address to the city or municipality where it is located."@en ;
    rdfs:label "in city"@en .


# Data Properties

:hasName a owl:DatatypeProperty ;
    rdfs:domain :Accommodation ;
    rdfs:range xsd:string ;
    rdfs:comment "The official or commercial name of the accommodation."@en ;
    rdfs:label "has name"@en .

:categoryLevel a owl:DatatypeProperty ;
    rdfs:domain :Accommodation ;
    rdfs:range xsd:integer ;
    rdfs:comment "The official rating level (1 to 5) of the accommodation: stars, or oak leaves for rural hotels. Absent when the accommodation is not rated."@en ;
    rdfs:label "category level"@en .

:hasStreet a owl:DatatypeProperty ;
    rdfs:domain :Address ;
    rdfs:range xsd:string ;
    rdfs:comment "The name and number of the street or road as part of a physical address."@en ;
    rdfs:label "has street"@en .

:postalCode a owl:DatatypeProperty ;
    rdfs:domain :Address ;
    rdfs:range xsd:string ;
    rdfs:comment "The postal code associated with the physical address."@en ;
    rdfs:label "postal code"@en .
