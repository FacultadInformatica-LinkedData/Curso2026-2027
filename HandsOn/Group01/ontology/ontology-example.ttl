@prefix ont:  <http://smartcity.linkeddata.es/touristaccommodation/ontology/> .
@prefix acc:  <http://smartcity.linkeddata.es/touristaccommodation/resource/Accommodation/> .
@prefix addr: <http://smartcity.linkeddata.es/touristaccommodation/resource/Address/> .
@prefix city: <http://smartcity.linkeddata.es/touristaccommodation/resource/City/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

city:madrid a ont:City ;
    rdfs:label "Madrid" .

addr:HM-127 a ont:Address ;
    rdfs:label "Paseo De La Chopera" ;
    ont:hasStreet "De La Chopera" ;
    ont:postalCode "28045" ;
    ont:inCity city:madrid .

acc:HM-127 a ont:Hotel ;
    rdfs:label "Gran Legazpi" ;
    ont:hasName "Gran Legazpi" ;
    ont:categoryLevel 3 ;
    ont:hasAddress addr:HM-127 .
