<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <owl:Class rdf:about="http://smartcity.linkeddata.es/touristaccommodation/ontology/Pension">
    <rdfs:subClassOf rdf:resource="http://smartcity.linkeddata.es/touristaccommodation/ontology/Accommodation"/>
    <rdfs:label xml:lang="en">Pension</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://smartcity.linkeddata.es/touristaccommodation/ontology/Camping">
    <rdfs:subClassOf rdf:resource="http://smartcity.linkeddata.es/touristaccommodation/ontology/Accommodation"/>
    <rdfs:subClassOf rdf:resource="http://schema.org/Campground"/>
    <rdfs:label xml:lang="en">Camping</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://smartcity.linkeddata.es/touristaccommodation/ontology/inCity">
    <rdfs:domain rdf:resource="http://schema.org/PostalAddress"/>
    <rdfs:range rdf:resource="http://schema.org/City"/>
    <rdfs:label xml:lang="en">in city</rdfs:label>
    <rdfs:comment xml:lang="en">Links an address to the city resource where it is located. schema:addressLocality only admits text, so this property is kept to link to the City resource (which is linked to Wikidata).</rdfs:comment>
    <rdfs:seeAlso>
      <owl:DatatypeProperty rdf:about="http://schema.org/addressLocality">
        <rdfs:label xml:lang="en">address locality</rdfs:label>
        <rdfs:isDefinedBy rdf:resource="http://schema.org/"/>
      </owl:DatatypeProperty>
    </rdfs:seeAlso>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://schema.org/streetAddress">
    <rdfs:label xml:lang="en">street address</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://schema.org/"/>
  </owl:DatatypeProperty>
  <owl:Ontology rdf:about="http://smartcity.linkeddata.es/touristaccommodation/ontology/">
    <rdfs:label xml:lang="en">Tourist Accommodation Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">Ontology for the tourist accommodations of the Community of Madrid. Version 2 reuses classes and properties from Schema.org (http://schema.org/) and keeps its own terms only where Schema.org has no suitable equivalent.</rdfs:comment>
    <owl:versionInfo>2.0</owl:versionInfo>
  </owl:Ontology>
  <owl:DatatypeProperty rdf:about="http://schema.org/name">
    <rdfs:label xml:lang="en">name</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://schema.org/"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://smartcity.linkeddata.es/touristaccommodation/ontology/Inn">
    <rdfs:subClassOf rdf:resource="http://smartcity.linkeddata.es/touristaccommodation/ontology/Accommodation"/>
    <rdfs:label xml:lang="en">Inn</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://smartcity.linkeddata.es/touristaccommodation/ontology/ApartHotel">
    <rdfs:subClassOf rdf:resource="http://smartcity.linkeddata.es/touristaccommodation/ontology/Accommodation"/>
    <rdfs:subClassOf rdf:resource="http://schema.org/Hotel"/>
    <rdfs:label xml:lang="en">Apart-hotel</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://smartcity.linkeddata.es/touristaccommodation/ontology/RuralApartment">
    <rdfs:subClassOf rdf:resource="http://smartcity.linkeddata.es/touristaccommodation/ontology/RuralAccommodation"/>
    <rdfs:label xml:lang="en">Rural apartment</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://smartcity.linkeddata.es/touristaccommodation/ontology/TouristApartment">
    <rdfs:subClassOf rdf:resource="http://smartcity.linkeddata.es/touristaccommodation/ontology/Accommodation"/>
    <rdfs:label xml:lang="en">Tourist apartment</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://smartcity.linkeddata.es/touristaccommodation/ontology/categoryLevel">
    <rdfs:domain rdf:resource="http://smartcity.linkeddata.es/touristaccommodation/ontology/Accommodation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">category level</rdfs:label>
    <rdfs:comment xml:lang="en">Official category level of the accommodation (1-5 stars, or oak leaves for rural hotels). schema:starRating expects a Rating resource, so a plain integer property is kept.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://schema.org/starRating"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://smartcity.linkeddata.es/touristaccommodation/ontology/RuralHotel">
    <rdfs:subClassOf rdf:resource="http://smartcity.linkeddata.es/touristaccommodation/ontology/RuralAccommodation"/>
    <rdfs:subClassOf rdf:resource="http://schema.org/Hotel"/>
    <rdfs:label xml:lang="en">Rural hotel</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://smartcity.linkeddata.es/touristaccommodation/ontology/Hotel">
    <rdfs:subClassOf rdf:resource="http://smartcity.linkeddata.es/touristaccommodation/ontology/Accommodation"/>
    <rdfs:subClassOf rdf:resource="http://schema.org/Hotel"/>
    <rdfs:label xml:lang="en">Hotel</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://smartcity.linkeddata.es/touristaccommodation/ontology/Hostel">
    <rdfs:subClassOf rdf:resource="http://smartcity.linkeddata.es/touristaccommodation/ontology/Accommodation"/>
    <rdfs:subClassOf rdf:resource="http://schema.org/Hostel"/>
    <rdfs:label xml:lang="en">Hostel</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://smartcity.linkeddata.es/touristaccommodation/ontology/BoardingHouse">
    <rdfs:subClassOf rdf:resource="http://smartcity.linkeddata.es/touristaccommodation/ontology/Accommodation"/>
    <rdfs:label xml:lang="en">Boarding house</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://schema.org/address">
    <rdfs:label xml:lang="en">address</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://schema.org/"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://smartcity.linkeddata.es/touristaccommodation/ontology/TouristHome">
    <rdfs:subClassOf rdf:resource="http://smartcity.linkeddata.es/touristaccommodation/ontology/Accommodation"/>
    <rdfs:label xml:lang="en">Tourist home</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://smartcity.linkeddata.es/touristaccommodation/ontology/RuralHouse">
    <rdfs:subClassOf rdf:resource="http://smartcity.linkeddata.es/touristaccommodation/ontology/RuralAccommodation"/>
    <rdfs:label xml:lang="en">Rural house</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://schema.org/postalCode">
    <rdfs:label xml:lang="en">postal code</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://schema.org/"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://smartcity.linkeddata.es/touristaccommodation/ontology/Accommodation">
    <rdfs:subClassOf rdf:resource="http://schema.org/LodgingBusiness"/>
    <owl:disjointWith rdf:resource="http://schema.org/PostalAddress"/>
    <owl:disjointWith rdf:resource="http://schema.org/City"/>
    <rdfs:label xml:lang="en">Accommodation</rdfs:label>
    <rdfs:comment xml:lang="en">Tourist accommodation registered in the Community of Madrid.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://schema.org/City">
    <rdfs:label xml:lang="en">City</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://schema.org/"/>
  </owl:Class>
  <owl:Class rdf:about="http://smartcity.linkeddata.es/touristaccommodation/ontology/RuralAccommodation">
    <rdfs:subClassOf rdf:resource="http://smartcity.linkeddata.es/touristaccommodation/ontology/Accommodation"/>
    <rdfs:label xml:lang="en">Rural accommodation</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://schema.org/PostalAddress">
    <rdfs:label xml:lang="en">Postal address</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://schema.org/"/>
  </owl:Class>
</rdf:RDF>
