@prefix bm: <http://breathemadrid.es/ontology#> .
@prefix bmr: <http://breathemadrid.es/resource/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Municipality

<http://breathemadrid.es/resource/municipality/madrid> a bm:Municipality ;
    bm:municipalityName "Madrid" ;
    bm:municipalityCode "28079" ;
    owl:sameAs <http://www.wikidata.org/entity/Q2807> .

# Station category in the ontology hierarchy

bm:UrbanTrafficStation a owl:Class ;
    rdfs:subClassOf bm:Station ;
    skos:notation "UT" .

# Pollutants

<http://breathemadrid.es/resource/pollutant/dioxido-de-nitrogeno> a bm:Pollutant ;
    bm:pollutantName "NO2" ;
    bm:pollutantCode "8" ;
    bm:unit "ug/m3" .

<http://breathemadrid.es/resource/pollutant/pm10> a bm:Pollutant ;
    bm:pollutantName "PM10" ;
    bm:pollutantCode "10" ;
    bm:unit "ug/m3" .

# Stations

<http://breathemadrid.es/resource/station/plaza-de-espana> a bm:Station, bm:UrbanTrafficStation ;
    bm:stationCode "28079004" ;
    bm:stationName "Plaza de Espana" ;
    bm:address "Plaza de Espana" ;
    bm:latitude "40.4238823"^^xsd:float ;
    bm:longitude "-3.7122567"^^xsd:float ;
    bm:altitude 637 ;
    bm:locatedIn <http://breathemadrid.es/resource/municipality/madrid> ;
    bm:measuresPollutant <http://breathemadrid.es/resource/pollutant/dioxido-de-nitrogeno> ;
    bm:measuresPollutant <http://breathemadrid.es/resource/pollutant/pm10> .

# Observations

<http://breathemadrid.es/resource/observation/plaza-de-espana/pm10/A/2026-10-01/H01> a bm:Observation ;
    bm:observedAt <http://breathemadrid.es/resource/station/plaza-de-espana> ;
    bm:observesPollutant <http://breathemadrid.es/resource/pollutant/pm10> ;
    bm:samplingPointCode "28079004_10_A" ;
    bm:value "42.0"^^xsd:float ;
    bm:dateTime "2026-10-01T01:00:00"^^xsd:dateTime ;
    bm:isValid "true"^^xsd:boolean .

<http://breathemadrid.es/resource/observation/plaza-de-espana/pm10/A/2026-10-01/H02> a bm:Observation ;
    bm:observedAt <http://breathemadrid.es/resource/station/plaza-de-espana> ;
    bm:observesPollutant <http://breathemadrid.es/resource/pollutant/pm10> ;
    bm:samplingPointCode "28079004_10_A" ;
    bm:value "44.0"^^xsd:float ;
    bm:dateTime "2026-10-01T02:00:00"^^xsd:dateTime ;
    bm:isValid "true"^^xsd:boolean .
