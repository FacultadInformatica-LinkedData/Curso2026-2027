@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix bm: <http://breathemadrid.es/ontology#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix schema: <https://schema.org/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <http://breathemadrid.es/mappings/> .

# Run with HandsOn/Group04 as the working directory.
# Same mapping as airquality-with-links.rml but using ontology/airquality-updated.ttl

# Stations, station types and municipality
# Source: csv/212629-0-estaciones-control-aire-with-links.csv

<#StationMap> a rr:TriplesMap ;
  rml:logicalSource [ rml:source "csv/212629-0-estaciones-control-aire-with-links.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [
    rr:template "http://breathemadrid.es/resource/station/{CODIGO}" ;
    rr:class bm:Station
  ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "ESTACION" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate dct:identifier ;
    rr:objectMap [ rml:reference "CODIGO" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate schema:name ;
    rr:objectMap [ rml:reference "ESTACION" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate schema:address ;
    rr:objectMap [ rml:reference "DIRECCION" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate geo:lat ;
    rr:objectMap [ rml:reference "LATITUD" ; rr:datatype xsd:float ] ] ;
  rr:predicateObjectMap [ rr:predicate geo:long ;
    rr:objectMap [ rml:reference "LONGITUD" ; rr:datatype xsd:float ] ] ;
  rr:predicateObjectMap [ rr:predicate geo:alt ;
    rr:objectMap [ rml:reference "ALTITUD" ; rr:datatype xsd:integer ] ] ;
  rr:predicateObjectMap [ rr:predicate bm:hasStationType ;
    rr:objectMap [ rr:template "http://breathemadrid.es/resource/stationtype/{COD_TIPO}" ;
      rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate dbo:municipality ;
    rr:objectMap [ rr:constant <http://breathemadrid.es/resource/municipality/28079> ] ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:seeAlso ;
    rr:objectMap [ rr:template "http://www.wikidata.org/entity/{WIKIDATA_LUGAR}" ;
      rr:termType rr:IRI ] ] .

<#StationTypeMap> a rr:TriplesMap ;
  rml:logicalSource [ rml:source "csv/212629-0-estaciones-control-aire-with-links.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [
    rr:template "http://breathemadrid.es/resource/stationtype/{COD_TIPO}" ;
    rr:class bm:StationType
  ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "NOM_TIPO" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate skos:notation ;
    rr:objectMap [ rml:reference "COD_TIPO" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate skos:prefLabel ;
    rr:objectMap [ rml:reference "NOM_TIPO" ; rr:language "es" ] ] .

<#MunicipalityMap> a rr:TriplesMap ;
  rml:logicalSource [ rml:source "csv/212629-0-estaciones-control-aire-with-links.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [
    rr:constant <http://breathemadrid.es/resource/municipality/28079> ;
    rr:class bm:Municipality
  ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ;
    rr:objectMap [ rr:constant "Madrid" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate dct:identifier ;
    rr:objectMap [ rr:constant "28079" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate schema:name ;
    rr:objectMap [ rr:constant "Madrid" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate owl:sameAs ;
    rr:objectMap [ rr:constant <http://www.wikidata.org/entity/Q2807> ] ] .


# Observations and pollutants
# Sources: csv/calair_tiemporeal-updated.csv, csv/contaminantes-updated.csv

<#ObservationMap> a rr:TriplesMap ;
  rml:logicalSource [ rml:source "csv/calair_tiemporeal-updated.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [
    rr:template "http://breathemadrid.es/resource/observation/{PUNTO_MUESTREO}/{FECHA}/H{HORA}" ;
    rr:class bm:Observation
  ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ;
    rr:objectMap [ rr:template "Observation {ID_OBSERVACION}" ; rr:termType rr:Literal ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate sosa:resultTime ;
    rr:objectMap [ rml:reference "FECHA_HORA" ; rr:datatype xsd:dateTime ] ] ;
  rr:predicateObjectMap [ rr:predicate sosa:hasSimpleResult ;
    rr:objectMap [ rml:reference "VALOR_MEDICION" ; rr:datatype xsd:float ] ] ;
  rr:predicateObjectMap [ rr:predicate bm:isValid ;
    rr:objectMap [ rml:reference "ES_VALIDA" ; rr:datatype xsd:boolean ] ] ;
  rr:predicateObjectMap [ rr:predicate bm:observedAt ;
    rr:objectMap [ rr:template "http://breathemadrid.es/resource/station/{PROVINCIA}{MUNICIPIO}{COD_ESTACION}" ;
      rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate sosa:observedProperty ;
    rr:objectMap [ rr:template "http://breathemadrid.es/resource/pollutant/{MAGNITUD}" ;
      rr:termType rr:IRI ] ] .

# Pollutants measured by each station, derived from the measurements
<#StationPollutantMap> a rr:TriplesMap ;
  rml:logicalSource [ rml:source "csv/calair_tiemporeal-updated.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [
    rr:template "http://breathemadrid.es/resource/station/{PROVINCIA}{MUNICIPIO}{COD_ESTACION}"
  ] ;
  rr:predicateObjectMap [ rr:predicate bm:measuresPollutant ;
    rr:objectMap [ rr:template "http://breathemadrid.es/resource/pollutant/{MAGNITUD}" ;
      rr:termType rr:IRI ] ] .

<#PollutantMap> a rr:TriplesMap ;
  rml:logicalSource [ rml:source "csv/contaminantes-updated.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [
    rr:template "http://breathemadrid.es/resource/pollutant/{MAGNITUD}" ;
    rr:class bm:Pollutant
  ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "NOMBRE" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate dct:identifier ;
    rr:objectMap [ rml:reference "MAGNITUD" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate schema:name ;
    rr:objectMap [ rml:reference "NOMBRE" ; rr:language "es" ] ] ;
  rr:predicateObjectMap [ rr:predicate schema:alternateName ;
    rr:objectMap [ rml:reference "FORMULA" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate qudt:hasUnit ;
    rr:objectMap [ rr:template "http://qudt.org/vocab/unit/{UNIDAD_QUDT}" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate owl:sameAs ;
    rr:objectMap [ rr:template "http://www.wikidata.org/entity/{WIKIDATA_ID}" ; rr:termType rr:IRI ] ] .
