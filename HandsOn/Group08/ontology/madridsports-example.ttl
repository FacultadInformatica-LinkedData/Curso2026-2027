@prefix ms: <http://madridsports.example.org/ontology/madridsports#> .
@prefix facility: <http://madridsports.example.org/resource/facility/> .
@prefix district: <http://madridsports.example.org/resource/district/> .
@prefix neighbourhood: <http://madridsports.example.org/resource/neighbourhood/> .
@prefix facilityType: <http://madridsports.example.org/resource/facilityType/> .
@prefix accessibilityLevel: <http://madridsports.example.org/resource/accessibilityLevel/> .
@prefix accessibilityFeature: <http://madridsports.example.org/resource/accessibilityFeature/> .
@prefix city: <http://madridsports.example.org/resource/city/> .
@prefix dataset: <http://madridsports.example.org/resource/dataset/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .

# Sample instantiation of the Madrid sports facilities ontology.
# Facilities are real rows of the three source CSV files (PK in the URI).

# ---- Dataset description (licence and attribution) -------------------------

dataset:madridSports a dcat:Dataset ;
    dcterms:title "Madrid municipal sports facilities (RDF)"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:source <https://datos.madrid.es/dataset/200215-0-instalaciones-deportivas> ,
        <https://datos.madrid.es/dataset/200186-0-polideportivos> ,
        <https://datos.madrid.es/dataset/210227-0-piscinas-publicas> ;
    dcterms:description "Contains data of the Ayuntamiento de Madrid (datos.madrid.es), licensed under CC BY 4.0. Derived from those datasets and modified: transformed to RDF."@en .

# ---- City ------------------------------------------------------------------

city:madrid a ms:City ;
    rdfs:label "Madrid"@es ;
    owl:sameAs <http://dbpedia.org/resource/Madrid> ,
        <http://www.wikidata.org/entity/Q2807> .

# ---- Districts -------------------------------------------------------------

district:4 a ms:District ;
    rdfs:label "SALAMANCA"@es ;
    ms:districtCode 4 ;
    ms:partOfCity city:madrid .

district:9 a ms:District ;
    rdfs:label "MONCLOA-ARAVACA"@es ;
    ms:districtCode 9 ;
    ms:partOfCity city:madrid .

district:11 a ms:District ;
    rdfs:label "CARABANCHEL"@es ;
    ms:districtCode 11 ;
    ms:partOfCity city:madrid .

district:12 a ms:District ;
    rdfs:label "USERA"@es ;
    ms:districtCode 12 ;
    ms:partOfCity city:madrid .

district:18 a ms:District ;
    rdfs:label "VILLA DE VALLECAS"@es ;
    ms:districtCode 18 ;
    ms:partOfCity city:madrid .

# ---- Neighbourhoods (URI = district code - neighbourhood number) ----------------

neighbourhood:4-2 a ms:Neighbourhood ;
    rdfs:label "GOYA"@es ;
    ms:neighbourhoodNumber 2 ;
    ms:belongsToDistrict district:4 .

neighbourhood:9-3 a ms:Neighbourhood ;
    rdfs:label "CIUDAD UNIVERSITARIA"@es ;
    ms:neighbourhoodNumber 3 ;
    ms:belongsToDistrict district:9 .

neighbourhood:11-3 a ms:Neighbourhood ;
    rdfs:label "SAN ISIDRO"@es ;
    ms:neighbourhoodNumber 3 ;
    ms:belongsToDistrict district:11 .

neighbourhood:12-2 a ms:Neighbourhood ;
    rdfs:label "ORCASUR"@es ;
    ms:neighbourhoodNumber 2 ;
    ms:belongsToDistrict district:12 .

neighbourhood:18-3 a ms:Neighbourhood ;
    rdfs:label "ENSANCHE DE VALLECAS"@es ;
    ms:neighbourhoodNumber 3 ;
    ms:belongsToDistrict district:18 .

# ---- Facility types ----------------------------------------------------------

facilityType:Calistenia a ms:FacilityType ;
    rdfs:label "Calistenia"@es .

facilityType:CamposEstadiosFutbol a ms:FacilityType ;
    rdfs:label "CamposEstadiosFutbol"@es .

facilityType:PistasPatinaje a ms:FacilityType ;
    rdfs:label "PistasPatinaje"@es .

facilityType:PistasTenisBadminton a ms:FacilityType ;
    rdfs:label "PistasTenisBadminton"@es .

facilityType:Sauna a ms:FacilityType ;
    rdfs:label "Sauna"@es .

# ---- Accessibility values (code list of the ACCESIBILIDAD column) ------------

accessibilityLevel:0 a ms:AccessibilityLevel ;
    rdfs:label "Not accessible"@en ;
    ms:accessibilityCode 0 .

accessibilityLevel:1 a ms:AccessibilityLevel ;
    rdfs:label "Accessible"@en ;
    ms:accessibilityCode 1 .

accessibilityLevel:2 a ms:AccessibilityLevel ;
    rdfs:label "Partially accessible for people with reduced mobility"@en ;
    ms:accessibilityCode 2 .

accessibilityLevel:3 a ms:AccessibilityLevel ;
    rdfs:label "No information on accessibility for people with reduced mobility"@en ;
    ms:accessibilityCode 3 .

accessibilityFeature:4 a ms:AccessibilityFeature ;
    rdfs:label "Sign language"@en ;
    ms:accessibilityCode 4 .

accessibilityFeature:5 a ms:AccessibilityFeature ;
    rdfs:label "Tactile paving"@en ;
    ms:accessibilityCode 5 .

accessibilityFeature:6 a ms:AccessibilityFeature ;
    rdfs:label "Magnetic induction loop"@en ;
    ms:accessibilityCode 6 .

# ---- Sports facilities -------------------------------------------------------

