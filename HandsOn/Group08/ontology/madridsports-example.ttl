    ms:hasSwimmingPool true ;
    dcterms:source <http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&vgnextoid=ef93827a9e41c010VgnVCM2000000c205a0aRCRD> .

facility:4617960 a ms:SportsCentre ;
    rdfs:label "Centro Deportivo Municipal Antiguo Canódromo"@es ;
    ms:sourceKey 4617960 ;
    ms:openingHours "Horario de uso en las instalaciones deportivas: Para saber el horario de apertura de las distintas instalaciones del centro deportivo, les rogamos lo consulten con el propio centro."@es ;
    ms:equipment "Clases y escuelas deportivas Estas son las modalidades deportivas que se ofrecen en los Centros Deportivos Municipales. Dichas modalidades pueden sufrir modificaciones a lo largo del curso. Le rogamos que consulte con su Centro Deportivo Municipal para confirmar si se ha producido algún cambio. Equipamientos Superficie: 9.000 metros cuadrados. Unidades deportivas cubiertas: fisio-hidroterápia y sala multiusos. Unidades deportivas al aire libre: campo de fútbol 11 césped artificial, campo de fútbol 7 césped artificial y mesa de teqball. Acceso controlado."@es ;
    ms:transport "Consulta los siguientes enlaces."@es ;
