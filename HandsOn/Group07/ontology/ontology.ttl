@prefix : <http://www.madridurbanenvironment.org/ontology/> .
@prefix ue: <http://www.madridurbanenvironment.org/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.madridurbanenvironment.org/ontology/> .

<http://www.madridurbanenvironment.org/ontology/> rdf:type owl:Ontology ;
                                                   rdfs:comment "Lightweight ontology for drinking fountains, benches, public toilets and parks of Madrid."@en ;
                                                   rdfs:label "Madrid urban environment ontology"@en .

#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.madridurbanenvironment.org/ontology/belongsToDistrict
ue:belongsToDistrict rdf:type owl:ObjectProperty ;
                     rdfs:domain ue:Neighborhood ;
                     rdfs:range ue:District ;
                     rdfs:label "belongs to district"@en .


###  http://www.madridurbanenvironment.org/ontology/locatedInDistrict
ue:locatedInDistrict rdf:type owl:ObjectProperty ;
                     rdfs:domain ue:UrbanFacility ;
                     rdfs:range ue:District ;
                     rdfs:label "located in district"@en .


###  http://www.madridurbanenvironment.org/ontology/locatedInNeighborhood
ue:locatedInNeighborhood rdf:type owl:ObjectProperty ;
                         rdfs:domain ue:UrbanFacility ;
                         rdfs:range ue:Neighborhood ;
                         rdfs:label "located in neighborhood"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.madridurbanenvironment.org/ontology/accessibilityLevel
ue:accessibilityLevel rdf:type owl:DatatypeProperty ;
                      rdfs:domain ue:Park ;
                      rdfs:range xsd:integer ;
                      rdfs:label "accessibility level"@en .


###  http://www.madridurbanenvironment.org/ontology/code
ue:code rdf:type owl:DatatypeProperty ;
        rdfs:domain ue:Neighborhood ;
        rdfs:range xsd:string ;
        rdfs:comment "Official numeric code of a district or neighborhood."@en ;
        rdfs:label "code"@en .


###  http://www.madridurbanenvironment.org/ontology/districtCode
ue:districtCode rdf:type owl:DatatypeProperty ;
                rdfs:domain ue:District ;
                rdfs:range xsd:string ;
                rdfs:label "district code"@en .


###  http://www.madridurbanenvironment.org/ontology/identifier
ue:identifier rdf:type owl:DatatypeProperty ;
              rdfs:domain ue:UrbanFacility ;
              rdfs:range xsd:string ;
              rdfs:label "identifier"@en .


###  http://www.madridurbanenvironment.org/ontology/installationDate
ue:installationDate rdf:type owl:DatatypeProperty ;
                    rdfs:domain ue:Bench ,
                                ue:DrinkingFountain ,
                                ue:PublicToilet ;
                    rdfs:range xsd:date ;
                    rdfs:label "installation date"@en .


###  http://www.madridurbanenvironment.org/ontology/intendedUse
ue:intendedUse rdf:type owl:DatatypeProperty ;
               rdfs:domain ue:DrinkingFountain ;
               rdfs:range xsd:string ;
               rdfs:comment "Who the fountain is meant for: people, pets, or both."@en ;
               rdfs:label "intended use"@en .


###  http://www.madridurbanenvironment.org/ontology/latitude
ue:latitude rdf:type owl:DatatypeProperty ;
            rdfs:domain ue:UrbanFacility ;
            rdfs:range xsd:decimal ;
            rdfs:label "latitude"@en .


###  http://www.madridurbanenvironment.org/ontology/longitude
ue:longitude rdf:type owl:DatatypeProperty ;
             rdfs:domain ue:UrbanFacility ;
             rdfs:range xsd:decimal ;
             rdfs:label "longitude"@en .


###  http://www.madridurbanenvironment.org/ontology/model
ue:model rdf:type owl:DatatypeProperty ;
         rdfs:domain ue:Bench ,
                     ue:DrinkingFountain ,
                     ue:Park ;
         rdfs:range xsd:string ;
         rdfs:label "model"@en .


###  http://www.madridurbanenvironment.org/ontology/name
ue:name rdf:type owl:DatatypeProperty ;
        rdfs:domain ue:UrbanFacility ;
        rdfs:range xsd:string ;
        rdfs:label "name"@en .


###  http://www.madridurbanenvironment.org/ontology/postalCode
ue:postalCode rdf:type owl:DatatypeProperty ;
              rdfs:domain ue:UrbanFacility ;
              rdfs:range xsd:string ;
              rdfs:label "postal code"@en .


###  http://www.madridurbanenvironment.org/ontology/schedule
ue:schedule rdf:type owl:DatatypeProperty ;
            rdfs:domain ue:Park ;
            rdfs:range xsd:string ;
            rdfs:label "schedule"@en .


###  http://www.madridurbanenvironment.org/ontology/status
ue:status rdf:type owl:DatatypeProperty ;
          rdfs:domain ue:Bench ,
                      ue:DrinkingFountain ;
          rdfs:range xsd:string ;
          rdfs:label "status"@en .


###  http://www.madridurbanenvironment.org/ontology/streetName
ue:streetName rdf:type owl:DatatypeProperty ;
              rdfs:domain ue:UrbanFacility ;
              rdfs:range xsd:string ;
              rdfs:label "street name"@en .


###  http://www.madridurbanenvironment.org/ontology/streetNumber
ue:streetNumber rdf:type owl:DatatypeProperty ;
                rdfs:domain ue:UrbanFacility ;
                rdfs:range xsd:string ;
                rdfs:label "street number"@en .


###  http://www.madridurbanenvironment.org/ontology/webPage
ue:webPage rdf:type owl:DatatypeProperty ;
           rdfs:domain ue:Park ;
           rdfs:range xsd:anyURI ;
           rdfs:label "web page"@en .


#################################################################
#    Classes
#################################################################

###  http://www.madridurbanenvironment.org/ontology/Bench
ue:Bench rdf:type owl:Class ;
         rdfs:subClassOf ue:UrbanFacility ;
         rdfs:label "Bench"@en .


###  http://www.madridurbanenvironment.org/ontology/District
ue:District rdf:type owl:Class ;
            rdfs:comment "Administrative district of Madrid."@en ;
            rdfs:label "District"@en .


###  http://www.madridurbanenvironment.org/ontology/DrinkingFountain
ue:DrinkingFountain rdf:type owl:Class ;
                    rdfs:subClassOf ue:UrbanFacility ;
                    rdfs:label "Drinking fountain"@en .


###  http://www.madridurbanenvironment.org/ontology/Neighborhood
ue:Neighborhood rdf:type owl:Class ;
                rdfs:comment "Neighborhood (barrio) inside a district of Madrid."@en ;
                rdfs:label "Neighborhood"@en .


###  http://www.madridurbanenvironment.org/ontology/Park
ue:Park rdf:type owl:Class ;
        rdfs:subClassOf ue:UrbanFacility ;
        rdfs:label "Park"@en .


###  http://www.madridurbanenvironment.org/ontology/PublicToilet
ue:PublicToilet rdf:type owl:Class ;
                rdfs:subClassOf ue:UrbanFacility ;
                rdfs:label "Public toilet"@en .


###  http://www.madridurbanenvironment.org/ontology/UrbanFacility
ue:UrbanFacility rdf:type owl:Class ;
                 rdfs:comment "Any piece of urban equipment or green area located in Madrid."@en ;
                 rdfs:label "Urban facility"@en .


