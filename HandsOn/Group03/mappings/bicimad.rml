@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix rml: <http://semweb.mmlab.be/ns/rml#>.
@prefix ql: <http://semweb.mmlab.be/ns/ql#>.
@prefix transit: <http://vocab.org/transit/terms/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vocab: <http://example.org#> .
@prefix bm: <https://bicismart.madrid.data.es/ontology#> .
@prefix bmres: <https://bicismart.madrid.data.es/resource/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.com/ns#>.

<#BikeStationMap> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "csv/bikestationbicimad-updated.csv" ;
    rml:referenceFormulation ql:CSV 
  ];
  rr:subjectMap [
    rr:template "https://bicismart.madrid.data.es/resource/BikeStation/{stationId}";
    rr:class bm:BikeStation
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [
      rml:reference "name";
      rr:datatype xsd:string;
      rr:termType rr:Literal;
      ]
  ];

  rr:predicateObjectMap [
    rr:predicate bm:stationId;
    rr:objectMap [
      rml:reference "stationId";
      rr:datatype xsd:string;
      rr:termType rr:Literal;
      ]
  ];

  rr:predicateObjectMap [
    rr:predicate bm:totalCapacity;
    rr:objectMap [
      rml:reference "totalBases";
      rr:datatype xsd:integer;
      rr:termType rr:Literal;
      ]
  ];

  rr:predicateObjectMap [
    rr:predicate bm:hasPoint;
    rr:objectMap [
      rr:parentTriplesMap <#PointMap>
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate bm:hasState;
    rr:objectMap [
      rr:parentTriplesMap <#StateMap>
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate bm:locatedOnStreet;
    rr:objectMap [
      rr:parentTriplesMap <#StreetMap>;
      rr:joinCondition [
        rr:child "streetName"; rr:parent "streetName";
      ];
      rr:joinCondition [
        rr:child "streetType"; rr:parent "streetType";
      ];
    ]
  ].

<#PointMap> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "csv/bikestationbicimad-updated.csv" ;
    rml:referenceFormulation ql:CSV 
  ];
  rr:subjectMap [
    rr:template "https://bicismart.madrid.data.es/resource/Point/{stationId}";
    rr:class geo:Point
  ];

  rr:predicateObjectMap [
    rr:predicate geo:lat;
    rr:objectMap [
      rml:reference "latitude";
      rr:datatype xsd:double;
      rr:termType rr:Literal;
      ]
  ];

  rr:predicateObjectMap [
    rr:predicate geo:long;
    rr:objectMap [
      rml:reference "longitude";
      rr:datatype xsd:double;
      rr:termType rr:Literal;
      ]
  ].

<#StateMap> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "csv/bikestationbicimad-updated.csv" ;
    rml:referenceFormulation ql:CSV 
  ];
  rr:subjectMap [
    rr:template "https://bicismart.madrid.data.es/resource/StationState/{stationId}";
    rr:class bm:StationState
  ];

  rr:predicateObjectMap [
    rr:predicate bm:isActivated;
    rr:objectMap [
      rml:reference "isActivated";
      rr:datatype xsd:boolean;
      rr:termType rr:Literal;
      ]
  ];

  rr:predicateObjectMap [
    rr:predicate bm:operationalState;
    rr:objectMap [
      rml:reference "operationalState";
      rr:datatype xsd:string;
      rr:termType rr:Literal;
      ]
  ];

  rr:predicateObjectMap [
    rr:predicate bm:unavailableBases;
    rr:objectMap [
      rml:reference "unavailableBases";
      rr:datatype xsd:integer;
      rr:termType rr:Literal;
      ]
  ].

  <#StreetMap> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "csv/CallejeroOficial-updated.csv" ;
    rml:referenceFormulation ql:CSV 
  ];
  rr:subjectMap [
    rr:template "https://bicismart.madrid.data.es/resource/Street/{streetCode}";
    rr:class bm:Street
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [
      rml:reference "streetName";
      rr:datatype xsd:string;
      rr:termType rr:Literal;
      ]
  ];

  rr:predicateObjectMap [
    rr:predicate bm:streetCode;
    rr:objectMap [
      rml:reference "streetCode";
      rr:datatype xsd:integer;
      rr:termType rr:Literal;
      ]
  ];

  rr:predicateObjectMap [
    rr:predicate bm:streetName;
    rr:objectMap [
      rml:reference "streetName";
      rr:datatype xsd:string;
      rr:termType rr:Literal;
      ]
  ];

  rr:predicateObjectMap [
    rr:predicate bm:districtCode;
    rr:objectMap [
      rml:reference "districtCode";
      rr:datatype xsd:integer;
      rr:termType rr:Literal;
      ]
  ];

  rr:predicateObjectMap [
    rr:predicate bm:neighborhoodCode;
    rr:objectMap [
      rml:reference "neighborhoodCode";
      rr:datatype xsd:integer;
      rr:termType rr:Literal;
      ]
  ];

  rr:predicateObjectMap [
    rr:predicate bm:postalCode;
    rr:objectMap [
      rml:reference "postalCode";
      rr:datatype xsd:string;
      rr:termType rr:Literal;
      ]
  ].