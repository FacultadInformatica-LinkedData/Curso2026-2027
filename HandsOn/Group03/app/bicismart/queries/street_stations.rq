PREFIX bm:   <https://bicismart.madrid.data.es/ontology#>
PREFIX geo:  <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Estaciones utilizables situadas en una calle (bm:locatedOnStreet, enlace BiciMAD ↔ Callejero).
SELECT ?station ?id ?name ?lat ?lon ?capacity ?unavailable ?usable
WHERE {
  VALUES ?street { $street }
  ?station bm:locatedOnStreet ?street .
  #include _station
  FILTER (?usable)
}
