@prefix : <http://w3id.org/madrid-culture/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

###################################################################################################
# Example of a data represented using the ontology (It is the same for both museum and library)
###################################################################################################

<http://w3id.org/madrid-culture/resource/library/1757/> a :Library ;
    rdfs:label "Biblioteca Pública Municipal Aluche (Latina)" ;
    schema:name "Biblioteca Pública Municipal Aluche (Latina)" ;
    :transport "Metro: Laguna (línea 6),  Aluche (línea 5) Cercanías Renfe: Laguna, Aluche (línea C5)" ;
    :hasAccessibility <http://w3id.org/madrid-culture/resource/accessibility/1757/> ;
    schema:url <http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&vgnextoid=7f0e3d0b5e71c010VgnVCM1000000b205a0aRCRD/> ;
    :hasAddress <http://w3id.org/madrid-culture/resource/address/1757/> ;
    schema:latitude "40.39597072367931"^^xsd:decimal ;
    schema:longitude "-3.7562716852987847"^^xsd:decimal ;
    schema:telephone "91 719 89 96" ;
    :email "bpaluche@madrid.es" ;
    :type "BibliotecasPublicas" .

<http://w3id.org/madrid-culture/resource/accessibility/1757/> a :Accessibility ;
    :accessible true ;
    :partiallyAccessible false ;
    :noInfoAccessibility false ;
    :signLanguage false ;
    :tactilePaving true ;
    :magneticInductionLoop true .

<http://w3id.org/madrid-culture/resource/address/1757/> a :Address ;
    :streetAddress "CALLE CAMARENA, 10" ;
    :postalCode "28047" ;
    :locatedInDistrict <http://w3id.org/madrid-culture/resource/district/10/> ;
    :locatedInNeighborhood <http://w3id.org/madrid-culture/resource/neighborhood/10-4/> .

<http://w3id.org/madrid-culture/resource/district/10/> a :District ;
    schema:name "LATINA" .

<http://w3id.org/madrid-culture/resource/neighborhood/10-4/> a :Neighborhood ;
    schema:name "ALUCHE" .

