<#LibraryAddressesMap> a rr:TriplesMap;
    rml:logicalSource [ 
        rml:source "csv/libraries-updated-with-links.csv"; 
        rml:referenceFormulation ql:CSV 
    ];

    rr:subjectMap [
        rr:template "http://w3id.org/madrid-culture/resource/address/{PK}";
        rr:class mc:Address;
        rr:termType rr:IRI
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:streetAddress; 
        rr:objectMap [ 
            rml:reference "DIRECCION"; 
            rr:datatype xsd:string 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:postalCode; 
        rr:objectMap [ 
            rml:reference "CODIGO-POSTAL"; 
            rr:datatype xsd:string 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:locatedInDistrict; 
        rr:objectMap [ 
            rr:template "http://w3id.org/madrid-culture/resource/district/{COD-DISTRITO}"; 
            rr:termType rr:IRI 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:locatedInNeighborhood; 
        rr:objectMap [ 
            rr:template "http://w3id.org/madrid-culture/resource/neighborhood/{COD-DISTRITO}-{COD-BARRIO}"; 
            rr:termType rr:IRI 
        ] 
    ].

