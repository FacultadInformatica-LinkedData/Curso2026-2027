    rr:predicateObjectMap [ 
        rr:predicate owl:sameAs;
        rr:objectMap [ 
            rml:reference "SAME-AS-NOMBRE"; 
            rr:termType rr:IRI
        ] 
    ].

<#MuseumAccessibilityMap> a rr:TriplesMap;
    rml:logicalSource [
        rml:source "csv/museums-updated-with-links.csv";
        rml:referenceFormulation ql:CSV
    ];

    rr:subjectMap [
        rr:template "http://w3id.org/madrid-culture/resource/accessibility/{PK}";
        rr:class mc:Accessibility;
        rr:termType rr:IRI
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:accessible; 
        rr:objectMap [ 
            rml:reference "ACCESIBLE";
            rr:datatype xsd:boolean 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:partiallyAccessible; 
        rr:objectMap [ 
            rml:reference "PARCIALMENTE-ACCESIBLE";
            rr:datatype xsd:boolean 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:noInfoAccessibility; 
        rr:objectMap [ 
            rml:reference "SIN-INFORMACION-ACCESIBILIDAD";
            rr:datatype xsd:boolean 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:signLanguage; 
        rr:objectMap [ 
            rml:reference "LENGUA-SIGNO";
            rr:datatype xsd:boolean 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:tactilePaving; 
        rr:objectMap [ 
            rml:reference "SEÑALIZACION-PODOTACTIL";
            rr:datatype xsd:boolean 
        ] 
    ];

    rr:predicateObjectMap [ 
        rr:predicate mc:magneticInductionLoop; 
        rr:objectMap [ 
            rml:reference "BUCLE-INDUCCION-MAGNETICO";
            rr:datatype xsd:boolean 
        ] 
    ].

