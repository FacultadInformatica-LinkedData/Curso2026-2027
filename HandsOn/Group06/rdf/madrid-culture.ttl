    mc:hasAddress <https://w3id.org/madrid-culture/resource/address/2107> ;
    mc:transport "Metro: Guzmán el Bueno (líneas 6 y 7)." ;
    mc:type "Museos" .

<https://w3id.org/madrid-culture/resource/museum/2112> a mc:Museum ;
