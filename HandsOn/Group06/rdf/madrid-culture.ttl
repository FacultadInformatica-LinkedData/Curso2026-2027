    mc:type "BibliotecasPublicas" .

<https://w3id.org/madrid-culture/resource/library/1746> a mc:Library ;
    rdfs:label "Biblioteca Pública Municipal San Blas (San Blas-Canillejas)"@es ;
    schema1:description "La Biblioteca Pública Municipal San Blas se abrió al público el 10 de mayo de 1987 y al acto de inauguración acudió el entonces alcalde Juan Barranco. El espacio que ocupa actualmente fue un Seminario de Sacerdotes Migrantes, rehabilitado tras muchos años de abandono y un incendio que lo dejó en condiciones críticas. El Ayuntamiento lo reformó para instalar en él el Centro Cultural Antonio Machado, dentro del que se encuentra la biblioteca. El edificio tiene forma redonda y tres plantas y lo preside un busto del poeta Antonio Machado. La Biblioteca se sitúa en la segunda planta. El edificio también alberga la Escuela Municipal de Música Antonio Machado. Canal de WhatsApp"@es ;
    schema1:latitude 40.420231627534996 ;
    schema1:longitude -3.6218113860909074 ;
    schema1:name "Biblioteca Pública Municipal San Blas (San Blas-Canillejas)"@es ;
    schema1:openingHours "Apertura de lunes a viernes. Horario: de 8:30 a 21 horas. Verano (del 15 de junio al 15 de septiembre): de 8:30 a 20 horas. Cerrado: festivos y los días 24 y 31 de diciembre." ;
    schema1:telephone "91 313 52 97" ;
    schema1:url <http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&vgnextoid=2e403d0b5e71c010VgnVCM1000000b205a0aRCRD> ;
    mc:email "bpsanblas@madrid.es" ;
    mc:hasAddress <https://w3id.org/madrid-culture/resource/address/1746> ;
    mc:transport "Metro: Alsacia (línea 2)" ;
    mc:type "BibliotecasPublicas" .

