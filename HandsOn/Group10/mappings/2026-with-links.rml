@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix cls:  <https://group10.org/air-quality-2026/ontology/classes/> .
@prefix prop: <https://group10.org/air-quality-2026/ontology/properties/> .
@base <https://group10.org/air-quality-2026/mappings/> .


#Municipality

<#Municipality> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "csv/2026-with-links.csv" ;
    rml:referenceFormulation ql:CSV
  ];
  rr:subjectMap [
    rr:template "https://group10.org/air-quality-2026/resources/municipalities/municipality-{cod_municipio}" ;
    rr:class cls:Municipality
  ];
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "nombre_municipio" ; rr:termType rr:Literal ; rr:language "en" ]
  ];
  rr:predicateObjectMap [
    rr:predicate prop:hasMunicipalityCode ;
    rr:objectMap [ rml:reference "cod_municipio" ; rr:datatype xsd:string ]
  ];
  rr:predicateObjectMap [
    rr:predicate owl:sameAs ;
    rr:objectMap [ rml:reference "wikidata_municipio" ; rr:termType rr:IRI ]
  ] .


#Station

<#Station> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "csv/2026-with-links.csv" ;
    rml:referenceFormulation ql:CSV
  ];
  rr:subjectMap [
    rr:template "https://group10.org/air-quality-2026/resources/stations/station-{cod_estacion}" ;
    rr:class cls:Station
  ];
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rr:template "Monitoring station {cod_estacion}" ; rr:termType rr:Literal ; rr:language "en" ]
  ];
  rr:predicateObjectMap [
    rr:predicate prop:hasStationCode ;
    rr:objectMap [ rml:reference "estacion" ; rr:datatype xsd:integer ]
  ];
  rr:predicateObjectMap [
    rr:predicate prop:locatedIn ;
    rr:objectMap [ rr:template "https://group10.org/air-quality-2026/resources/municipalities/municipality-{cod_municipio}" ; rr:termType rr:IRI ]
  ] .


#MeasurementType

<#MeasurementType> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "csv/2026-with-links.csv" ;
    rml:referenceFormulation ql:CSV
  ];
  rr:subjectMap [
    rr:template "https://group10.org/air-quality-2026/resources/measurement-types/magnitude-{magnitud}" ;
    rr:class cls:MeasurementType
  ];
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rr:template "Measurement type {magnitud}" ; rr:termType rr:Literal ; rr:language "en" ]
  ];
  rr:predicateObjectMap [
    rr:predicate prop:hasMeasurementCode ;
    rr:objectMap [ rml:reference "magnitud" ; rr:datatype xsd:integer ]
  ] .


# SamplePoint

<#SamplePoint> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "csv/2026-with-links.csv" ;
    rml:referenceFormulation ql:CSV
  ];
  rr:subjectMap [
    rr:template "https://group10.org/air-quality-2026/resources/sample-points/{punto_muestreo}" ;
    rr:class cls:SamplePoint
  ];
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rr:template "Sampling point {punto_muestreo}" ; rr:termType rr:Literal ; rr:language "en" ]
  ];
  rr:predicateObjectMap [
    rr:predicate prop:hasStation ;
    rr:objectMap [ rr:template "https://group10.org/air-quality-2026/resources/stations/station-{cod_estacion}" ; rr:termType rr:IRI ]
  ];
  rr:predicateObjectMap [
    rr:predicate prop:hasMeasurementType ;
    rr:objectMap [ rr:template "https://group10.org/air-quality-2026/resources/measurement-types/magnitude-{magnitud}" ; rr:termType rr:IRI ]
  ];
  rr:predicateObjectMap [
    rr:predicate prop:hasTechnique ;
    rr:objectMap [ rr:constant "89" ; rr:datatype xsd:integer ]
  ] .


#Observations: one TriplesMap per hourly column (h01 ... h24)

# Hour 01
<#Observation_h01> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "csv/2026-with-links.csv" ;
    rml:referenceFormulation ql:CSV
  ];
  rr:subjectMap [
    rr:template "https://group10.org/air-quality-2026/resources/observations/{punto_muestreo}-{ano}-{mes}-{dia}-h01" ;
    rr:class cls:Observation
  ];
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rr:template "Observation {punto_muestreo} on {ano}-{mes}-{dia} at hour 1" ; rr:termType rr:Literal ; rr:language "en" ]
  ];
  rr:predicateObjectMap [
    rr:predicate prop:hasSamplePoint ;
    rr:objectMap [ rr:template "https://group10.org/air-quality-2026/resources/sample-points/{punto_muestreo}" ; rr:termType rr:IRI ]
  ];
  rr:predicateObjectMap [
    rr:predicate prop:hasYear ;
    rr:objectMap [ rml:reference "ano" ; rr:datatype xsd:integer ]
  ];
  rr:predicateObjectMap [
    rr:predicate prop:hasMonth ;
    rr:objectMap [ rml:reference "mes" ; rr:datatype xsd:integer ]
  ];
  rr:predicateObjectMap [
    rr:predicate prop:hasDay ;
    rr:objectMap [ rml:reference "dia" ; rr:datatype xsd:integer ]
  ];
  rr:predicateObjectMap [
    rr:predicate prop:hasHour ;
    rr:objectMap [ rr:constant "1" ; rr:datatype xsd:integer ]
  ];
  rr:predicateObjectMap [
    rr:predicate prop:hasValue ;
    rr:objectMap [ rml:reference "h01" ; rr:datatype xsd:decimal ]
  ];
  rr:predicateObjectMap [
    rr:predicate prop:isValidated ;
    rr:objectMap [ rr:constant "true" ; rr:datatype xsd:boolean ]
  ] .

