PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ont: <http://smartcity.linkeddata.es/bicis/ontology#>

# Consulta para verificar los enlaces owl:sameAs de los distritos
SELECT ?distrito ?nombreDistrito ?wikidataURI
WHERE {
  ?distrito a ont:District ;
            rdfs:label ?nombreDistrito ;
            owl:sameAs ?wikidataURI .
}