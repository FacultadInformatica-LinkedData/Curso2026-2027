@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ont: <http://smartcity.linkeddata.es/bicis/ontology#> .
@prefix res: <http://smartcity.linkeddata.es/bicis/resource/> .
@base <http://smartcity.linkeddata.es/bicis/mapping/> .

<#BicycleParkingMapping> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/aparcabicis_madrid-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    
    rr:subjectMap [
        rr:template "http://smartcity.linkeddata.es/bicis/resource/BicycleParking/{ID}" ;
        rr:class ont:BicycleParking
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rr:template "Aparcabicis {ID}" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:id ;
        rr:objectMap [ rml:reference "ID" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:hasModel ;
        rr:objectMap [ rml:reference "MODELO" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:streetAddress ;
        rr:objectMap [ rr:template "{TIPO_VIA} {NOM_VIA}, {NUM_VIA}" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:latitude ;
        rr:objectMap [ rml:reference "LATITUD" ; rr:datatype xsd:decimal ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:longitude ;
        rr:objectMap [ rml:reference "LONGITUD" ; rr:datatype xsd:decimal ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:inDistrict ;
        rr:objectMap [
            rr:template "http://smartcity.linkeddata.es/bicis/resource/District/{DISTRITO}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ont:inNeighborhood ;
        rr:objectMap [
            rr:template "http://smartcity.linkeddata.es/bicis/resource/Neighborhood/{BARRIO}" ;
            rr:termType rr:IRI
        ]
    ] .

<#DistrictMapping> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/aparcabicis_madrid-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "http://smartcity.linkeddata.es/bicis/resource/District/{DISTRITO}" ;
        rr:class ont:District
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "DISTRITO" ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate owl:sameAs ;
        rr:objectMap [
            rml:reference "SAME_AS_WIKIDATA_DISTRITO" ;
            rr:termType rr:IRI
        ]
    ] .